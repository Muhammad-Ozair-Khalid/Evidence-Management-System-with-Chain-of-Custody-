# Copy to `.env` and adjust values for your environment.
#   cp .env.example .env

# PostgreSQL connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://ems:ems_dev_password@localhost:5432/ems_coc?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-in-production"

# File storage mode: "local" (dev) or "s3" (S3-compatible bucket)
STORAGE_MODE="local"

# Optional letterhead text on PDF custody reports
# ORGANIZATION_NAME="NCERT Forensic Evidence Unit"

# Required when STORAGE_MODE=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
